# Copy to .env and fill in. mcp_server/ loads these via databricks-sdk's
# standard env-var auth; python-dotenv (see requirements.txt) picks up .env
# automatically if you `from dotenv import load_dotenv; load_dotenv()` before
# running the server, or export them in your shell.

DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>

# Optional: override config/config.yaml without editing it.
# VARNAM_CATALOG=workspace
# VARNAM_SCHEMA=rag_demo
